# VPN Bot Panel configuration example
# Скопируйте в config.ini и заполните значения.

[DATABASE]
path = data/vpn_bot.db
backup_path = data/backups/
backup_retention_days = 30

[BOT]
token = YOUR_BOT_TOKEN_HERE
admin_telegram_id = 123456789

[WEB]
# secret_key генерируется автоматически при первом запуске панели
host = 127.0.0.1
port = 8080
debug = False

[PAYMENTS]
# Номер кошелька YooMoney (например, 41001234567890)
yoomoney_receiver = YOUR_YOOMONEY_WALLET
# Токен приложения YooMoney с правами operation-history
yoomoney_token = YOUR_YOOMONEY_TOKEN
# Опционально: CryptoBot
cryptobot_token =

[SECURITY]
max_login_attempts = 5
lockout_duration_minutes = 30
session_timeout_minutes = 60
password_min_length = 8
auto_unban_interval_hours = 6

[LOGGING]
level = INFO
file = logs/vpn_bot.log
max_size_mb = 10
backup_count = 5
