#!/bin/bash

# VPN Bot Panel - Главное меню управления
# Запуск: sudo ./Boot-main-ini

SERVICE_NAME="vpnbot"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON="$SCRIPT_DIR/venv/bin/python"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; BLUE='\033[0;34m'; NC='\033[0m'
log_info()    { echo -e "${BLUE}[INFO] $1${NC}"; }
log_success() { echo -e "${GREEN}[OK]   $1${NC}"; }
log_warning() { echo -e "${YELLOW}[WARN] $1${NC}"; }
log_error()   { echo -e "${RED}[ERR]  $1${NC}"; }

service_status() {
    if systemctl is-active --quiet "$SERVICE_NAME.service" 2>/dev/null; then
        echo -e "${GREEN}запущена${NC}"
    else
        echo -e "${RED}остановлена${NC}"
    fi
}

panel_port() {
    local port
    port=$(grep -E '^port' "$SCRIPT_DIR/config.ini" 2>/dev/null | head -1 | tr -dc '0-9')
    echo "${port:-8080}"
}

do_service() {
    local action="$1"
    case "$action" in
        start)   systemctl start  "$SERVICE_NAME.service" ;;
        stop)    systemctl stop   "$SERVICE_NAME.service" ;;
        restart) systemctl restart "$SERVICE_NAME.service" ;;
    esac
    sleep 2
}

show_logs() {
    local file="$1"
    if [ -f "$SCRIPT_DIR/$file" ]; then
        tail -n 50 "$SCRIPT_DIR/$file"
    else
        journalctl -u "$SERVICE_NAME.service" -n 50 --no-pager
    fi
}

manage_cli() {
    local args="$*"
    cd "$SCRIPT_DIR" || return 1
    $PYTHON -m app.manage $args
    echo ""
    read -rp "Нажмите Enter для продолжения..."
}

menu_system() {
    while true; do
        clear
        echo "=== Система (VPN Bot Panel: $(service_status)) ==="
        echo " 1. Статус сервиса"
        echo " 2. Запустить"
        echo " 3. Остановить"
        echo " 4. Перезапустить"
        echo " 5. Логи бота и панели (journalctl)"
        echo " 6. Файл лога приложения"
        echo " 0. Назад"
        read -rp "Выбор: " choice
        case "$choice" in
            1) systemctl status "$SERVICE_NAME.service" --no-pager -l | head -20
               read -rp "Enter..." ;;
            2) do_service start;   log_success "Команда выполнена"; sleep 1 ;;
            3) do_service stop;    log_success "Команда выполнена"; sleep 1 ;;
            4) do_service restart; log_success "Команда выполнена"; sleep 1 ;;
            5) journalctl -u "$SERVICE_NAME.service" -n 50 --no-pager
               read -rp "Enter..." ;;
            6) show_logs "logs/vpn_bot.log"; read -rp "Enter..." ;;
            0) break ;;
        esac
    done
}

menu_admins() {
    while true; do
        clear
        echo "=== Администраторы и доступ ==="
        echo " 1. Задать/сменить пароль веб-панели"
        echo " 2. Назначить роль пользователю"
        echo " 3. Проверка конфигурации и БД"
        echo " 0. Назад"
        read -rp "Выбор: " choice
        case "$choice" in
            1) read -rp "Telegram ID пользователя: " tg
               [ -n "$tg" ] && manage_cli set-password "$tg" ;;
            2) read -rp "Telegram ID: " tg
               read -rp "Роль (user|moderator|admin|super_admin): " role
               [ -n "$tg" ] && [ -n "$role" ] && manage_cli set-role "$tg" "$role" ;;
            3) manage_cli check ;;
            0) break ;;
        esac
    done
}

menu_backup() {
    clear
    echo "=== Резервная копия ==="
    read -rp "Создать резервную копию БД и config? (y/N): " yn
    if [[ "$yn" == "y" || "$yn" == "Y" ]]; then
        local dir="$SCRIPT_DIR/backups/manual_$(date +%Y%m%d_%H%M%S)"
        mkdir -p "$dir"
        cp "$SCRIPT_DIR/data/vpn_bot.db" "$dir/" 2>/dev/null && \
            log_success "БД скопирована"
        cp "$SCRIPT_DIR/config.ini" "$dir/" 2>/dev/null && \
            log_success "config.ini скопирован"
        chmod 600 "$dir"/* 2>/dev/null || true
        log_info "Копия: $dir"
        sleep 2
    fi
}

main_menu() {
    while true; do
        clear
        echo "=============================================="
        echo "      VPN Bot Panel - Управление"
        echo "=============================================="
        echo " Статус системы: $(service_status)"
        echo " Порт панели:    $(panel_port)"
        echo "----------------------------------------------"
        echo " 1. Управление системой"
        echo " 2. Администраторы и доступ"
        echo " 3. Обновить панель (git + зависимости + миграции)"
        echo " 4. Резервная копия"
        echo " 5. Удалить панель (uninstall.sh)"
        echo " 0. Выход"
        echo ""
        read -rp "Выберите пункт: " choice
        case "$choice" in
            1) menu_system ;;
            2) menu_admins ;;
            3) bash "$SCRIPT_DIR/update.sh"; read -rp "Enter..." ;;
            4) menu_backup ;;
            5) bash "$SCRIPT_DIR/uninstall.sh"; break ;;
            0) exit 0 ;;
        esac
    done
}

if [[ $EUID -ne 0 ]]; then
    log_error "Запустите с правами root: sudo $0"
    exit 1
fi

if [ ! -x "$PYTHON" ]; then
    log_error "Не найдено виртуальное окружение: $PYTHON"
    log_info "Сначала выполните установку: sudo ./install.sh"
    exit 1
fi

main_menu
